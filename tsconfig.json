{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "moduleResolution": "node",
    "module": "esnext",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@synchronicity/shared/*": ["packages/shared/src/*"],
      "@synchronicity/engine/*": ["packages/engine/src/*"],
      "@synchronicity/trace/*": ["packages/trace/src/*"]
    }
  },
  "references": [
    { "path": "packages/shared" },
    { "path": "packages/engine" },
    { "path": "packages/trace" },
    { "path": "apps/backend" },
    { "path": "apps/frontend" }
  ]
}