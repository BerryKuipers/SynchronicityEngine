{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "jsx": "react-jsx",
    "allowJs": false,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.spec.ts", "**/*.test.ts"],
  "references": [
    { "path": "../../packages/engine" },
    { "path": "../../packages/shared" },
    { "path": "../../packages/trace" }
  ]
}
